# ============================================================
# 本地开发配置模板
# 用法：复制本文件为 application-local.yml，填入自己的口令与密钥
#      cp application-local.yml.example application-local.yml
# application-local.yml 已被 .gitignore 排除，不会进版本库
# ============================================================
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/cobot_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: CHANGE_ME
  ai:
    openai:
      # 在这里填本地开发用的 API Key（也可不改此文件，改用环境变量 AI_API_KEY）
      api-key:CHANGE_ME
